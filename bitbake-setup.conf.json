            "path": "openembedded-core"
        },
        "meta-yocto": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.yoctoproject.org/meta-yocto;protocol=https"
                    }
                },
                "branch": "master",
                "rev": "c7fa63bea78248597798739aa4da49a9f4405b9c"
            },
            "path": "meta-yocto"
        },
        "meta-openembedded": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "git://git.openembedded.org/meta-openembedded;protocol=https"
                    }
                },
                "branch": "master",
                "rev": "6b55bede28261c38fb1da1474ca5c991ac414c93"
            },
            "path": "meta-openembedded"
        },
        "meta-exein": {
