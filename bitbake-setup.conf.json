    "bitbake-setup": {
        "configurations": [
            {
                "name": "qemu-ex",
                "description": "Minimal QEMU image with Exein/Pulsar security runtime",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-networking",
                    "meta-exein"
                ],
                "bb-layers-file-relative": [
                    "meta-application"
                ],
                "oe-fragments": ["core/yocto/sstate-mirror-cdn", "application/shared-sstate", "application/qemu-ex"],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine architecture",
                        "options": ["machine/qemuarm64", "machine/qemux86-64"]
                    },
                    "distro": {
                        "description": "Distribution variants",
                        "options": ["distro/poky"]
                    }
                }
            },
            {
                "name": "docker-ex",
                "description": "Minimal Docker/OCI container image with webservice",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-filesystems",
                    "meta-virtualization"
                ],
                "bb-layers-file-relative": [
                    "meta-application"
                ],
                "oe-fragments": ["core/yocto/sstate-mirror-cdn", "application/shared-sstate", "application/docker-ex"],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine architecture",
                        "options": ["machine/qemux86-64"]
                    },
                    "distro": {
                        "description": "Distribution variants",
                        "options": ["distro/poky"]
                    }
                }
            }
        ]
    }
}
